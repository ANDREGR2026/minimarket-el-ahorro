# Copiar este archivo como .env y ajustar segun el entorno.
# Valores por defecto de Laragon: usuario root sin contrasena.
DB_HOST=localhost
DB_NAME=minimarket
DB_USER=root
DB_PASS=

# Correo saliente (recuperacion de contrasena).
# Si PHPMailer no esta instalado (composer require phpmailer/phpmailer),
# el sistema usa la funcion mail() nativa de PHP con estos mismos datos.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-responder@elahorro.pe
MAIL_FROM_NOMBRE=EL AHORRO
