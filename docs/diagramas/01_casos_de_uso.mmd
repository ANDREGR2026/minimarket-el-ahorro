flowchart LR
  classDef actor fill:#FFFFFF,stroke:#1F2937,color:#111827,stroke-width:2px
  classDef use fill:#FFFFFF,stroke:#475569,color:#111827,stroke-width:1.5px
  classDef boundary fill:#F8FAFC,stroke:#94A3B8,color:#111827,stroke-width:1px

  subgraph A[Actores]
    direction TB
    VIS["«actor»\nVisitante"]:::actor
    CAJ["«actor»\nCajero"]:::actor
    ALM["«actor»\nAlmacenero"]:::actor
    ADM["«actor»\nAdministrador"]:::actor
    SUP["«actor»\nSuperadministrador"]:::actor
  end

  subgraph S["Sistema web para la gestión de un minimarket"]
    direction TB
    PUB([Catálogo público\nconsulta, búsqueda y filtros]):::use
    SES([Autenticación\ninicio y recuperación de contraseña]):::use
    VEN([Ventas\nregistro, consulta, anulación y comprobante]):::use
    CLI([Clientes\nregistro, edición y consulta]):::use
    INV([Inventario\nmovimientos, kardex y productos]):::use
    CAT([Catálogo interno\nproductos y categorías]):::use
    REP([Gestión\npanel, reportes y exportación]):::use
    BAC([Respaldo\nconfiguración, generación y descarga]):::use
    USU([Usuarios y roles\naltas, edición y estados]):::use
  end

  VIS --- PUB
  CAJ --- SES & VEN & CLI & CAT
  ALM --- SES & INV & CAT
  ADM --- VEN & CLI & INV & CAT & REP & BAC & USU
  SUP --- USU
  SUP -. hereda permisos .-> ADM
